{
  "name": "graphql-federation-subgraph",
  "version": "0.0.0",
  "description": "GraphQL Federation Spec directives for any TypeScript GraphQL server — a server-agnostic alternative to @apollo/subgraph.",
  "license": "MIT",
  "author": "ChilliCream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChilliCream/graphql-federation-subgraph.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "graphql": "^16.11.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.0",
    "@graphql-tools/utils": "^12.0.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "fastify": "^5.12.0",
    "graphql": "^16.11.0",
    "graphql-http": "^1.23.0",
    "graphql-yoga": "^5.21.3",
    "mercurius": "^16.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "graphql",
    "federation",
    "graphql-federation",
    "subgraph",
    "composite-schemas",
    "composite-schema-spec",
    "source-schema",
    "directives",
    "typescript"
  ]
}
